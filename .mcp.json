{
  "mcpServers": {
    "entra-scim-mock": {
      "command": "npx",
      "args": [
        "-y",
        "entra-scim-mcp@0.3.0"
      ],
      "env": {
        "ENTRA_SCIM_BASE_URL": "http://127.0.0.1:8990",
        "ENTRA_SCIM_STATIC_TOKEN": "dev-token"
      }
    },
    "entra-lifecycle-intake": {
      "command": "node",
      "args": [
        "demo/intake/server.mjs"
      ],
      "env": {
        "LIFECYCLE_INTAKE_BACKEND": "stub"
      }
    }
  }
}
