# Live-tenant credentials for scripts/mcp-live.mjs (the "entra-scim-live" entry in .mcp.json).
# Copy to .env (gitignored) and fill in. Only that launcher reads this file; the published
# entra-scim-mcp server reads process.env only, so a stray .env never leaks into another session.
#
# App registration permissions (Microsoft Graph, application, admin consent) and the CSA sets,
# groups and domain the demo expects are listed in docs/live-tenant-setup.md.

# Directory (tenant) id of the Entra tenant.
ENTRA_TENANT_ID=
# Application (client) id of the app registration.
ENTRA_CLIENT_ID=
# Client secret VALUE (shown once at creation, not the secret id). Set this OR the certificate, never both.
ENTRA_CLIENT_SECRET=
# Path to a PEM file holding the certificate and its private key, for certificate auth. Alternative to the secret.
ENTRA_CLIENT_CERT_PATH=
# Password for the certificate file, if it has one.
ENTRA_CLIENT_CERT_PASSWORD=
# SCIM endpoint. Leave commented for the real API; the default is https://graph.microsoft.com/rp/scim.
# ENTRA_SCIM_BASE_URL=https://graph.microsoft.com/rp/scim

# ENTRA_SCIM_STATIC_TOKEN and ENTRA_SCIM_DRY_RUN must NOT be set in this file: scripts/mcp-live.mjs
# refuses to start when either is present. Use the entra-scim-mock and entra-scim-rehearsal
# entries in .mcp.json for the local mock and dry-run modes.
